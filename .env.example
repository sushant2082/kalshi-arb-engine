# Kalshi read-only credentials. Never commit the filled-in .env or the key file.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=kalshi_key.pem

# Endpoints
KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_WS_URL=wss://api.elections.kalshi.com/trade-api/ws/v2

# Fee model. VERIFY against current Kalshi docs per market category before trusting.
FEE_MULTIPLIER=0.07

# Detection thresholds
MIN_GUARANTEED_PROFIT=0.01
MIN_FILLABLE_SETS=2
MAX_LEG_COUNT_ALERT=4
LP_TOLERANCE=1e-6

# Series to scan. Comma-separated Kalshi series tickers.
# Target bracketed/laddered series, NOT two-sided moneylines.
TARGET_SERIES=KXBTCD,KXETHD,KXHIGHNY,KXCPIYOY

# Polling
KALSHI_POLL_SEC=10
MAX_QUOTE_AGE_SEC=30

# Paper trading (simulation only; never places real orders)
PAPER_ENABLED=true
PAPER_BANKROLL=10000.0
PAPER_MAX_SETS_PER_OPP=50
PAPER_LEG_FILL_PROB=1.0
PAPER_SLIPPAGE_CENTS=0.0
